# ESP32_GENERIC_S3_XC16M：小程 ESP32S3 掌机（16MB Flash + 8MB Octal PSRAM）
# 音频：ES7210 ADC (I2C 0x43) + ES8311 DAC (I2C 0x18)，共享 I2S 总线
# （BCLK/WS 共用），MCLK 由 Python 侧 PWM 生成（256×fs），XL9535 管电源时序
# esp-sr v2.6.1（master），IDF v5.5.6
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16MiB.csv"

# esp-sr 预编译库要求的 cache 配置
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# 唤醒词：小明同学（wn9_xiaomingtongxue_tts2）
CONFIG_SR_WN_WN9_XIAOMINGTONGXUE_TTS2=y
# 命令词：中文 MultiNet7 量化版
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
CONFIG_SR_MN_EN_NONE=y
# VAD：WebRTC 轻量版
CONFIG_SR_VADN_WEBRTC=y
