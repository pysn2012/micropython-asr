# ESP32_GENERIC_S3 + ESP-SR 配置（esp-sr v2.0.0，IDF v5.5.1）
# 适配立创 ESP32-S3（N8R8：8MB Flash + 8MB Octal PSRAM）
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8MiB.csv"

# esp-sr 预编译库要求的 cache 配置
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# 唤醒词：Hi,乐鑫（wn9_hilexin）
CONFIG_SR_WN_WN9_HILEXIN=y
# 命令词：中文 MultiNet7 量化版
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
CONFIG_SR_MN_EN_NONE=y
# VAD：WebRTC 轻量版
CONFIG_SR_VADN_WEBRTC=y
